# Copy to .env.local for `npm run dev`, and set the same values as Worker
# secrets/variables on Cloudflare (npx wrangler secret put TFL_APP_KEY).

# TfL Unified API key from https://api-portal.tfl.gov.uk (free). Without it TfL
# allows about 50 requests a minute from one address, which a busy site exceeds.
TFL_APP_KEY=

# Bus Open Data Service key from https://data.bus-data.dft.gov.uk (free). Live bus
# positions, including London buses (operator TFLO).
BODS_API_KEY=

# Met Office Weather DataHub, NSWWS warnings API (free plan) from
# https://datahub.metoffice.gov.uk. Gives each warning's area, so only warnings
# reaching Greater London are listed and drawn. Without it the public RSS for
# London & South East England is used.
METOFFICE_NSWWS_KEY=

# KV namespace id for the daily visit counter (see cloudflare.config.ts). Optional.
SMARTLDN_VISITS_KV_ID=
